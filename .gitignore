# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
.wrangler/

# Local run outputs (drivers export here; not part of the repo)
/runs/
*.stats.json

# Internal/session notes live in ../MARB-private (separate private repo)

# Answer key — distributed via the gated HF dataset, never version-controlled.
# (Working-tree slots are synced copies of the canonical private storage;
# see tasks/m3_crete/ANSWER_KEY.md.)
tasks/m3_crete/m3_reference_round1.step
tasks/m3_crete/m3_reference_assembly.yaml

# Belt-and-braces for future task keys — mirrors the blocked path patterns in
# scripts/check_no_answer_keys.sh (enforced by pre-push hook + key-guard CI).
tasks/**/*reference*.step
tasks/**/*reference*assembly*.yaml
tasks/**/*reference*layout*.yaml
tasks/**/*reference*scene*.json
tasks/**/ph*_reference*

# Leak signature — the fingerprint used to detect a submission that reproduced
# superseded reference data instead of solving. Publishing what the detector
# looks for would let an entrant avoid it, leaving a filter that only catches
# the honest. Gated alongside the answer key.
tasks/**/leak_signature.yaml
tasks/**/*leak_signature*.y*ml

# The marb.cadclaw.io source must be reviewable and reproducible from Git.
# A locally held display font remains excluded from the release artifact until
# its redistribution rights are documented; the site uses system fallbacks.
/publishing/fonts/
/.cloudflare/
analysis/pascal-editor/runs/
tasks/pascal_house/ph1_reference_layout.yaml
tasks/pascal_house/ph1_reference_scene.json

# Unpublished media pulled from the site 2026-08-21 (kept locally, never served)
_unpublished_media_*/

# Licensed display faces (Typodermic Nulshock/Sifonn) are NOT redistributable.
# They must never re-enter this public repository.
*.otf
*.ttf
**/Nulshock*

#!/bin/sh
# MARB pre-push guard: refuse to push any commit that touches an answer-key
# path, then hand off to Git LFS (this file REPLACES the stock LFS hook and
# preserves its behavior — the ref lines from stdin are captured once and fed
# to both stages).
#
# Install (from the repo root):
#   cp scripts/hooks/pre-push .git/hooks/pre-push
#
# CI runs the same check (.github/workflows/key-guard.yml), so a bypassed or
# uninstalled hook is still caught server-side.

zero=0000000000000000000000000000000000000000
repo_root=$(git rev-parse --show-toplevel) || exit 1
guard="$repo_root/scripts/check_no_answer_keys.sh"

refs=$(cat)

if [ -f "$guard" ]; then
  fail=0
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_ref" ] && continue
    [ "$local_sha" = "$zero" ] && continue   # ref deletion — nothing new to scan
    if [ "$remote_sha" = "$zero" ]; then
      # New remote ref: scan every commit not already on some remote.
      sh "$guard" --range "$local_sha" --not --remotes || fail=1
    else
      sh "$guard" --range "$remote_sha..$local_sha" || fail=1
    fi
  done <<EOF
$refs
EOF
  [ "$fail" -ne 0 ] && { echo "pre-push: push rejected by answer-key guard." >&2; exit 1; }
else
  echo "pre-push: WARNING scripts/check_no_answer_keys.sh missing; key guard skipped." >&2
fi

# --- stock Git LFS hook, unchanged apart from stdin replay ---
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
if [ -n "$refs" ]; then
  printf '%s\n' "$refs" | git lfs pre-push "$@"
else
  git lfs pre-push "$@" </dev/null
fi
